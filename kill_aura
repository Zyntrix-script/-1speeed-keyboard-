-- BUTTON 1: TELEPORT 1 → TRACKSTART
--========================================================

KeepConnection(tele12.Activated:Connect(function()
    if enabled or busy then
        enabled = false
        status.Text = "ĐANG LOADING ..."
        return
    end

    enabled = true
    tele12.Text = "DỪNG CHỐNG HỘ VỆ"
    status.Text = "ĐANG TELE 1..."

    task.spawn(function()
        if not TeleportTo(FIRST_POSITION) then
            enabled = false
            if not closed then
                tele12.Text = "CHỐNG HỘ VỆ"
                status.Text = "KHÔNG CÓ NHÂN VẬT"
            end
            return
        end

        status.Text = "ĐANG TÌM BYPASS ..."

        local target
        for _ = 1, 30 do
            if not enabled or closed then
                enabled = false
                return
            end

            target = FindTrackStart()
            if target then break end
            task.wait(0.2)
        end

        if not enabled or closed then
            enabled = false
            return
        end

        if not target then
            status.Text = "Lol"
            enabled = false
            tele12.Text = "CHỐNG HỘ VỆ"
            return
        end

        status.Text = "CHỜ TRONG 10 STUDS..."

        while enabled and not closed do
            local _, _, root = GetParts()

            if not root or not target.Parent then
                status.Text = "MẤT NHÂN VẬT / MỤC TIÊU"
                break
            end

            if (root.Position - target.Position).Magnitude
                <= TRIGGER_DISTANCE then

                status.Text = "ĐANG BYPASS ..."
                enabled = false

                local success = SmoothTeleport(
                    target.Position + Vector3.new(0, 3, 0)
                )

                if not closed then
                    status.Text = success
                        and "HOÀN TẤT TELE 1 → 2"
                        or "Lol:)"
                end
                break
            end

            task.wait(0.15)
        end

        enabled = false
        if not closed then
            tele12.Text = "CHỐNG HỘ VỆ"
        end
    end)
end))

