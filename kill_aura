--========================================================--
-- GLOBAL RANDOM COLOR SPLIT & TEXT SHINE EFFECT
--========================================================--

task.spawn(function()
    task.wait(0.5)

    -- Danh sách các bảng màu ngẫu nhiên để chuyển đổi liên tục
    local ColorPresets = {
        {Color3.fromRGB(255, 100, 150), Color3.fromRGB(77, 224, 255), Color3.fromRGB(255, 255, 255)},
        {Color3.fromRGB(111, 207, 236), Color3.fromRGB(139, 105, 210), Color3.fromRGB(255, 255, 255)},
        {Color3.fromRGB(91, 224, 165), Color3.fromRGB(77, 224, 255), Color3.fromRGB(255, 255, 255)},
        {Color3.fromRGB(255, 180, 100), Color3.fromRGB(255, 100, 220), Color3.fromRGB(255, 255, 255)},
        {Color3.fromRGB(200, 100, 255), Color3.fromRGB(55, 187, 218), Color3.fromRGB(255, 255, 255)}
    }

    local function ApplyRandomColorShine(textObj)
        if textObj:FindFirstChildOfClass("UIGradient") then return end

        local shineGrad = New("UIGradient", textObj, {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(100, 220, 255)),
                ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 255, 255))
            }),
            Offset = Vector2.new(-1.2, 0)
        })

        -- Luồng chạy hiệu ứng đổi màu 2 nửa ngẫu nhiên và trượt ánh sáng
        task.spawn(function()
            while textObj and textObj.Parent and ScreenGui.Parent do
                -- Đổi màu ngẫu nhiên liên tục
                local chosenColors = ColorPresets[math.random(1, #ColorPresets)]
                shineGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, chosenColors[1]),
                    ColorSequenceKeypoint.new(0.4, chosenColors[2]),
                    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)), -- Điểm lóe sáng ở giữa 2 màu
                    ColorSequenceKeypoint.new(0.6, chosenColors[2]),
                    ColorSequenceKeypoint.new(1.0, chosenColors[1])
                })

                -- Trượt dải sáng qua lại
                local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                local tween = TweenService:Create(shineGrad, tweenInfo, { Offset = Vector2.new(1.2, 0) })
                tween:Play()
                
                tween.Completed:Wait()
                shineGrad.Offset = Vector2.new(-1.2, 0)
                task.wait(math.random(0.5, 1.5))
            end
        end)
    end

    for _, descendant in ipairs(ScreenGui:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            if descendant.Name ~= "Close" then
                ApplyRandomColorShine(descendant)
            end
        end
    end

    ScreenGui.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            if descendant.Name ~= "Close" then
                ApplyRandomColorShine(descendant)
            end
        end
    end)
end)


