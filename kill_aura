--==============================================================
-- STOP ANTI EGG WALK
--==============================================================

local function StopAntiEggWalk()

	AntiEggWalking = false

	if AntiEggWalkConnection then

		AntiEggWalkConnection:Disconnect()
		AntiEggWalkConnection = nil

	end

	if Humanoid
		and Humanoid.Parent
		and Humanoid.Health > 0 then

		pcall(function()

			Humanoid:Move(
				Vector3.zero,
				false
			)

		end)
	end
end

--==============================================================
-- START ANTI EGG WALK
--==============================================================

local function StartAntiEggWalk(MyToken)

	if Closed
		or IsDead
		or MyToken ~= AntiEggToken then

		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then

		return
	end

	StopAntiEggWalk()

	AntiEggWalking = true

	EggStatus.Text =
		"WALKING TO TARGET"

	EggStatus.TextColor3 =
		Color3.fromRGB(0,255,180)

	EggToggle.Text =
		"ANTI EGG • WALKING"

	local LastUpdate = 0

	AntiEggWalkConnection =
		RunService.Heartbeat:Connect(
			function()

				if Closed
					or IsDead
					or MyToken ~= AntiEggToken then

					StopAntiEggWalk()
					return
				end

				if not Character
					or not Character.Parent
					or not Humanoid
					or Humanoid.Health <= 0
					or not Root
					or not Root.Parent then

					StopAntiEggWalk()
					return
				end

				local Distance =
					(
						Root.Position
						- ANTI_EGG_POSITION
					).Magnitude

				if Distance <=
					ANTI_EGG_ARRIVE_DISTANCE then

					StopAntiEggWalk()

					EggStatus.Text =
						"ARRIVED • 549, 71, -364"

					EggStatus.TextColor3 =
						Color3.fromRGB(0,255,180)

					EggToggle.Text =
						"ANTI EGG • ARRIVED"

					return
				end

				local Now = os.clock()

				if Now - LastUpdate
					>= ANTI_EGG_WALK_REFRESH then

					LastUpdate = Now

					pcall(function()

						Humanoid:MoveTo(
							ANTI_EGG_POSITION
						)

					end)
				end
			end
		)
end

--==============================================================
-- ACTIVATE ANTI EGG
-- TELEPORT -> SOUND -> 1s -> WALK
--==============================================================

local function ActivateAntiEgg()

	if Closed or IsDead then
		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then

		EggStatus.Text =
			"CHARACTER NOT READY"

		EggStatus.TextColor3 =
			Color3.fromRGB(255,120,120)

		return
	end

	AntiEggToken += 1

	local MyToken =
		AntiEggToken

	StopAntiEggWalk()

	--==========================================================
	-- TELEPORT
	--==========================================================

	local Success =
		pcall(function()

			Root.CFrame =
				CFrame.new(
					ANTI_EGG_POSITION
				)

		end)

	if not Success then

		EggStatus.Text =
			"TELEPORT ERROR"

		EggStatus.TextColor3 =
			Color3.fromRGB(255,120,120)

		return
	end

	--==========================================================
	-- SOUND
	--==========================================================

	pcall(function()

		AntiEggSound:Stop()
		AntiEggSound.TimePosition = 0
		AntiEggSound:Play()

	end)

	--==========================================================
	-- STATUS
	--==========================================================

	EggStatus.Text =
		"TELEPORTED • WAIT 1s"

	EggStatus.TextColor3 =
		Color3.fromRGB(80,180,255)

	EggToggle.Text =
		"ANTI EGG • WAIT 1s"

	TweenService:Create(
		EggToggle,
		TweenInfo.new(0.12),
		{
			BackgroundColor3 =
				Color3.fromRGB(20,60,75)
		}
	):Play()

	--==========================================================
	-- WAIT 1 SECOND
	--==========================================================

	task.delay(
		ANTI_EGG_WALK_DELAY,
		function()

			if Closed
				or IsDead
				or MyToken ~= AntiEggToken then

				return
			end

			StartAntiEggWalk(
				MyToken
			)

		end
	)
end

