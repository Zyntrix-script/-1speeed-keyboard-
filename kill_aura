-- [[ MANUAL COLLECT - CLICK TO GATHER VERSION ]] --
local p = game:GetService("Players").LocalPlayer
local CoreGui = game:GetService("CoreGui")

local targetName = "StageEnd" -- Tên vật phẩm cần nhặt
local radius = 50000000 -- Khoảng cách quét (có thể chỉnh lên 10000 nếu muốn toàn map)

-- 1. GIAO DIỆN (UI)
local ScreenGui = Instance.new("ScreenGui", CoreGui)
local MainBtn = Instance.new("TextButton", ScreenGui)
MainBtn.Size = UDim2.new(0, 130, 0, 40)
MainBtn.Position = UDim2.new(0.9, -130, 0.6, 0)
MainBtn.Text = "Win "
MainBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215) -- Màu xanh dương
MainBtn.TextColor3 = Color3.new(1,1,1)
MainBtn.Font = Enum.Font.SourceSansBold
MainBtn.TextSize = 16
MainBtn.Draggable = true
local Corner = Instance.new("UICorner", MainBtn)

-- 2. LOGIC KHI BẤM NÚT
MainBtn.MouseButton1Click:Connect(function()
local char = p.Character
local hrp = char and char:FindFirstChild("HumanoidRootPart")

if hrp then  
    local count = 0  
    MainBtn.Text = "gần win"  
    MainBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)  

    for _, obj in pairs(workspace:GetDescendants()) do  
        -- Kiểm tra tên và khoảng cách  
        if obj.Name == targetName and obj:IsA("BasePart") then  
            local dist = (obj.Position - hrp.Position).Magnitude  
            if dist <= radius then  
                -- Giả lập chạm (Touch) để nhặt mà không cần di chuyển tới  
                firetouchinterest(hrp, obj, 0)  
                firetouchinterest(hrp, obj, 1)  
                count = count + 1  
            end  
        end  
    end  
      
    -- Thông báo kết quả trên nút  
    MainBtn.Text = "XONG! ("..count..")"  
    MainBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)  
      
    task.wait(1)  
    MainBtn.Text = "Win"  
    MainBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)  
end

end)

game:GetService("StarterGui"):SetCore("SendNotification", {
Title = "Manual Mode",
Text = "Bấm nút để thu thập vật phẩm xung quanh!",
Duration = 3 tạo file
})
