--========================================================--
-- IMAGE FUNCTION
--========================================================--

local function GetThumb(id)

    if not id
    or id == ""
    or id == "0" then

        return ""
    end

    return
        "rbxthumb://type=Asset&id="
        .. tostring(id)
        .. "&w=420&h=420"
end

--========================================================--
-- FIND TRACKSTART
--========================================================--

local function FindTrackStart()

    for _,obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if obj.Name == "TrackStart" then

            if obj:IsA("BasePart") then
                return obj
            end

            if obj:IsA("Attachment") then

                local parent =
                    obj.Parent

                if parent
                and parent:IsA("BasePart") then

                    return parent
                end
            end

            if obj:IsA("Model") then

                if obj.PrimaryPart then
                    return obj.PrimaryPart
                end

                local part =
                    obj:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )

                if part then
                    return part
                end
            end
        end
    end

    return nil
end

--========================================================--
-- STOP WALK
--========================================================--

local function StopWalking()

    Walking = false

    if WalkConnection then

        WalkConnection:Disconnect()

        WalkConnection = nil
    end

    if Humanoid then

        pcall(function()

            Humanoid:Move(
                Vector3.zero,
                false
            )

        end)
    end
end

--========================================================--
-- TELE
--========================================================--

local function TeleToTrackStart()

    if not Root
    or not Humanoid
    or Humanoid.Health <= 0 then

        return false
    end

    local target =
        FindTrackStart()

    if not target then
        return false
    end

    pcall(function()

        Root.CFrame =
            target.CFrame
            + Vector3.new(0,3,0)

    end)

    return true
end

--========================================================--
-- WALK
--========================================================--

local function WalkToTrackStart()

    if not Humanoid
    or not Root
    or Humanoid.Health <= 0 then

        return false
    end

    local target =
        FindTrackStart()

    if not target then
        return false
    end

    StopWalking()

    Walking = true

    WalkConnection =
        RunService.Heartbeat:Connect(
            function()

                if Destroyed
                or not Walking then

                    return
                end

                if not Character
                or not Character.Parent
                or not Humanoid
                or Humanoid.Health <= 0
                or not Root then

                    StopWalking()
                    return
                end

                local distance =
                    (
                        Root.Position
                        - target.Position
                    ).Magnitude

                if distance <= ARRIVE_DISTANCE then

                    StopWalking()

                    if Status
                    and Status.Parent then

                        Status.Text =
                            "● ARRIVED"

                        Status.TextColor3 =
                            GREEN
                    end

                    if WalkStroke
                    and WalkStroke.Parent then

                        WalkStroke.Color =
                            CYAN
                    end

                    return
                end

                -- Không thay WalkSpeed
                -- Dùng tốc độ hiện tại của game

                Humanoid:MoveTo(
                    target.Position
                )
            end
        )

    return true
end

