--==============================================================--
-- WALK
--==============================================================--

local function StartWalking()

    if Closed or IsDead then
        return
    end

    if not Character
        or not Character.Parent then
        return
    end

    if not Humanoid
        or Humanoid.Health <= 0 then
        return
    end

    if not Root
        or not Root.Parent then
        return
    end

    local Target =
        FindTrackStart()

    if not Target then

        Status.Text =
            "TRACKSTART NOT FOUND"

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                120,
                120
            )

        return
    end

    StopWalking()

    IsWalking = true

    Status.Text =
        "ANTI EGG • WALKING"

    Status.TextColor3 =
        Color3.fromRGB(
            0,
            255,
            180
        )

    AntiEggStroke.Color =
        Color3.fromRGB(
            0,
            255,
            170
        )

    local LastUpdate = 0

    WalkConnection =
        RunService.Heartbeat:Connect(
            function()

                if Closed or IsDead then
                    StopWalking()
                    return
                end

                if not Character
                    or not Character.Parent
                    or not Humanoid
                    or Humanoid.Health <= 0
                    or not Root
                    or not Root.Parent then

                    StopWalking()
                    return
                end

                if not Target
                    or not Target.Parent then

                    Target =
                        FindTrackStart()

                    if not Target then

                        StopWalking()

                        Status.Text =
                            "TRACKSTART LOST"

                        Status.TextColor3 =
                            Color3.fromRGB(
                                255,
                                120,
                                120
                            )

                        return
                    end
                end

                local Distance =
                    (
                        Root.Position
                        - Target.Position
                    ).Magnitude

                if Distance <= ARRIVE_DISTANCE then

                    StopWalking()

                    Status.Text =
                        "ANTI EGG • ARRIVED"

                    Status.TextColor3 =
                        Color3.fromRGB(
                            0,
                            255,
                            180
                        )

                    AntiEggStroke.Color =
                        Color3.fromRGB(
                            0,
                            212,
                            255
                        )

                    return
                end

                local Now = os.clock()

                if Now - LastUpdate
                    >= WALK_REFRESH then

                    LastUpdate = Now

                    pcall(function()

                        Humanoid:MoveTo(
                            Target.Position
                        )

                    end)
                end
            end
        )
end

--==============================================================--
-- ANTI EGG
-- TELE -> 1s -> WALK
--==============================================================--

local function ActivateAntiEgg()

    if Closed or IsDead then
        return
    end

    if not Character
        or not Character.Parent then
        return
    end

    if not Humanoid
        or Humanoid.Health <= 0 then
        return
    end

    if not Root
        or not Root.Parent then
        return
    end

    local Target =
        FindTrackStart()

    if not Target then

        Status.Text =
            "TRACKSTART NOT FOUND"

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                120,
                120
            )

        return
    end

    StopWalking()

    TeleWalkToken += 1

    local MyToken =
        TeleWalkToken

    --==========================================================--
    -- TELEPORT
    --==========================================================--

    local Success =
        pcall(function()

            Root.CFrame =
                Target.CFrame
                + Vector3.new(
                    0,
                    3,
                    0
                )

        end)

    if not Success then

        Status.Text =
            "TELEPORT ERROR"

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                120,
                120
            )

        return
    end

    --==========================================================--
    -- SOUND
    --==========================================================--

    pcall(function()

        TeleSound:Stop()
        TeleSound.TimePosition = 0
        TeleSound:Play()

    end)

    --==========================================================--
    -- WAIT 1 SECOND
    --==========================================================--

    Status.Text =
        "ANTI EGG • WAIT 1s"

    Status.TextColor3 =
        Color3.fromRGB(
            80,
            180,
            255
        )

    task.delay(
        TELE_WALK_DELAY,
        function()

            if Closed
                or IsDead then
                return
            end

            if MyToken ~= TeleWalkToken then
                return
            end

            if not Character
                or not Character.Parent then
                return
            end

            if not Humanoid
                or Humanoid.Health <= 0 then
                return
            end

            if not Root
                or not Root.Parent then
                return
            end

            StartWalking()

        end
    )
end

