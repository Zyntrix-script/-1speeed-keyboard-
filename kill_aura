--==============================================================--
-- FIND TRACKSTART
--==============================================================--

local function FindTrackStart()

    local Direct = Workspace:FindFirstChild("TrackStart")

    if Direct then

        if Direct:IsA("BasePart") then
            return Direct
        end

        if Direct:IsA("Attachment")
            and Direct.Parent
            and Direct.Parent:IsA("BasePart") then

            return Direct.Parent
        end

        if Direct:IsA("Model") then

            if Direct.PrimaryPart then
                return Direct.PrimaryPart
            end

            local Part =
                Direct:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if Part then
                return Part
            end
        end
    end

    for _, Obj in ipairs(Workspace:GetDescendants()) do

        if Obj.Name == "TrackStart" then

            if Obj:IsA("BasePart") then
                return Obj
            end

            if Obj:IsA("Attachment")
                and Obj.Parent
                and Obj.Parent:IsA("BasePart") then

                return Obj.Parent
            end

            if Obj:IsA("Model") then

                if Obj.PrimaryPart then
                    return Obj.PrimaryPart
                end

                local Part =
                    Obj:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )

                if Part then
                    return Part
                end
            end
        end
    end

    return nil
end

--==============================================================--
-- CHARACTER
--==============================================================--

local function SetupCharacter(Char)

    Character = Char

    Humanoid =
        Char:WaitForChild(
            "Humanoid",
            8
        )

    Root =
        Char:WaitForChild(
            "HumanoidRootPart",
            8
        )

    if not Humanoid or not Root then
        return false
    end

    IsDead = false

    return true
end

--==============================================================--
-- STOP WALKING
--==============================================================--

local function StopWalking()

    IsWalking = false

    if WalkConnection then
        WalkConnection:Disconnect()
        WalkConnection = nil
    end

    if Humanoid
        and Humanoid.Parent
        and Humanoid.Health > 0 then

        pcall(function()
            Humanoid:Move(Vector3.zero, false)
        end)
    end
end

