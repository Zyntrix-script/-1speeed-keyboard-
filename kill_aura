--========================================================
-- BUTTON 1: TELE 1 → WAIT NEAR TRACKSTART → TELE 2
--========================================================

tele12.Activated:Connect(function()
    if busy then
        status.Text = "ĐANG TELEPORT..."
        return
    end

    if enabled then
        enabled = false
        tele12.Text = "TELE 1 → 2 • START"
        status.Text = "ĐÃ DỪNG"
        return
    end

    enabled = true
    tele12.Text = "TELE 1 → 2 • STOP"
    status.Text = "ĐANG TELE 1..."

    task.spawn(function()
        if not TeleportFirst() then
            enabled = false
            tele12.Text = "TELE 1 → 2 • START"
            status.Text = "KHÔNG CÓ NHÂN VẬT"
            return
        end

        status.Text = "ĐANG TÌM TRACKSTART..."
        local target

        for _ = 1, 30 do
            if not enabled or closed then return end

            target = FindTrackStart()
            if target then break end

            task.wait(0.2)
        end

        if not enabled or closed then return end

        if not target then
            status.Text = "KHÔNG TÌM THẤY TRACKSTART"
            enabled = false
            tele12.Text = "TELE 1 → 2 • START"
            return
        end

        status.Text = "CHỜ TRONG 10 STUDS..."

        while enabled and not closed do
            local _, _, root = GetParts()

            if not root or not target.Parent then
                status.Text = "MẤT NHÂN VẬT / MỤC TIÊU"
                break
            end

            if (root.Position - target.Position).Magnitude
                <= TRIGGER_DISTANCE then

                status.Text = "ĐANG TELE 2..."
                enabled = false

                local success = SmoothTeleport(
                    target.Position + Vector3.new(0, 3, 0)
                )

                if not closed then
                    status.Text = success
                        and "TELE 1 → 2 • HOÀN TẤT"
                        or "TELE 2 THẤT BẠI"
                end

                break
            end

            task.wait(0.15)
        end

        enabled = false

        if not closed then
            tele12.Text = "TELE 1 → 2 • START"
        end
    end)
end)

