--==============================================================
-- CURSOR
--==============================================================

local cursor = nil

local function UpdateCursor(
    position
)

    if not controlsEnabled
        and
        not editMode then

        return
    end

    if not cursor then

        cursor =
            Instance.new(
                "ImageLabel"
            )

        cursor.Name =
            "TouchCursor"

        cursor.BackgroundTransparency =
            1

        cursor.ZIndex =
            500

        cursor.Image =
            "rbxthumb://type=Asset&id=12570006449&w=420&h=420"

        cursor.Parent =
            ControlLayer

    end

    cursor.Size =
        UDim2.fromOffset(
            cursorSize,
            cursorSize
        )

    cursor.Position =
        UDim2.fromOffset(

            position.X -
            cursorSize / 2,

            position.Y -
            cursorSize / 2

        )

end

