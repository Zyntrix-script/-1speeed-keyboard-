--==============================================================
-- MOVEMENT ENGINE
--==============================================================

RunService.RenderStepped:Connect(
    function()

        if not controlsEnabled then
            return
        end

        if editMode then
            return
        end

        local character =
            Player.Character

        local humanoid =
            character
            and
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not humanoid then
            return
        end

        local move =
            Vector3.zero

        if activeMovement.W then

            move += Vector3.new(
                0,
                0,
                -1
            )

        end

        if activeMovement.S then

            move += Vector3.new(
                0,
                0,
                1
            )

        end

        if activeMovement.A then

            move += Vector3.new(
                -1,
                0,
                0
            )

        end

        if activeMovement.D then

            move += Vector3.new(
                1,
                0,
                0
            )

        end

        humanoid:Move(
            move,
            true
        )

    end
)

