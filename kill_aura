--==============================================================

Knob.InputBegan:Connect(
    function(input)

        if input.UserInputType
            == Enum.UserInputType.Touch then

            sliderDragging =
                true

        end

    end
)

--==============================================================
-- CURSOR SLIDER MOVE
--==============================================================

UIS.InputChanged:Connect(
    function(input)

        if not sliderDragging then
            return
        end

        if input.UserInputType
            ~= Enum.UserInputType.Touch then

            return
        end

        local x =
            math.clamp(

                (
                    input.Position.X -
                    Slider.AbsolutePosition.X
                )
                /
                Slider.AbsoluteSize.X,

                0,
                1

            )

        Fill.Size =
            UDim2.new(
                x,
                0,
                1,
                0
            )

        Knob.Position =
            UDim2.new(
                x,
                -9,
                0.5,
                -9
            )

        cursorSize =
            math.floor(
                30 +
                x * 50
            )

        SliderLabel.Text =
            "Kích thước con trỏ: "
            ..
            tostring(
                cursorSize
            )

        if cursor then

            cursor.Size =
                UDim2.fromOffset(
                    cursorSize,
                    cursorSize
                )

        end

    end
)

--==============================================================
-- CURSOR SLIDER END
--==============================================================

UIS.InputEnded:Connect(
    function(input)

        if input.UserInputType
            == Enum.UserInputType.Touch then

            sliderDragging =
                false

        end

    end
)

