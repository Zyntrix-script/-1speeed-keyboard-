--==============================================================--
-- WALK
--==============================================================--

local function StartWalking()
    if Closed then
        return
    end

    if IsDead then
        return
    end

    if not Character or not Character.Parent then
        return
    end

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    if not Root or not Root.Parent then
        return
    end

    local Target = FindTrackStart()

    if not Target then
        Status.Text = "TRACKSTART NOT FOUND"
        Status.TextColor3 = Color3.fromRGB(255, 120, 120)
        return
    end

    StopWalking()

    IsWalking = true

    Status.Text = "WALKING • TRACKSTART"
    Status.TextColor3 = Color3.fromRGB(0, 255, 180)

    WalkStroke.Color = Color3.fromRGB(0, 255, 170)

    local LastUpdate = 0

    WalkConnection = RunService.Heartbeat:Connect(function()
        if Closed then
            StopWalking()
            return
        end

        if IsDead then
            StopWalking()
            return
        end

        if not Character
            or not Character.Parent
            or not Humanoid
            or Humanoid.Health <= 0
            or not Root
            or not Root.Parent then

            StopWalking()
            return
        end

        if not Target or not Target.Parent then
            Target = FindTrackStart()

            if not Target then
                StopWalking()
                Status.Text = "TRACKSTART LOST"
                Status.TextColor3 = Color3.fromRGB(255, 120, 120)
                return
            end
        end

        local Distance =
            (Root.Position - Target.Position).Magnitude

        if Distance <= ARRIVE_DISTANCE then
            StopWalking()

            Status.Text = "ARRIVED • TRACKSTART"
            Status.TextColor3 = Color3.fromRGB(0, 255, 180)

            WalkStroke.Color = Color3.fromRGB(0, 212, 255)

            return
        end

        local Now = os.clock()

        if Now - LastUpdate >= WALK_REFRESH then
            LastUpdate = Now

            pcall(function()
                Humanoid:MoveTo(Target.Position)
            end)
        end
    end)
end

--==============================================================--
-- TELEPORT
--==============================================================--

local function TeleportToTrackStart()
    if Closed then
        return
    end

    if IsDead then
        return
    end

    if not Character or not Character.Parent then
        return
    end

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    if not Root or not Root.Parent then
        return
    end

    local Target = FindTrackStart()

    if not Target then
        Status.Text = "TRACKSTART NOT FOUND"
        Status.TextColor3 = Color3.fromRGB(255, 120, 120)
        return
    end

    StopWalking()

    local Success = pcall(function()
        Root.CFrame =
            Target.CFrame
            + Vector3.new(0, 3, 0)
    end)

    if Success then
        Status.Text = "TELEPORTED • TRACKSTART"
        Status.TextColor3 = Color3.fromRGB(80, 180, 255)

        pcall(function()
            TeleSound:Stop()
            TeleSound.TimePosition = 0
            TeleSound:Play()
        end)

        task.delay(1.2, function()
            if not Closed and not IsDead and not IsWalking then
                SetReady()
            end
        end)
    else
        Status.Text = "TELEPORT ERROR"
        Status.TextColor3 = Color3.fromRGB(255, 120, 120)
    end
end

