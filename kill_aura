-- FAST INTERACT
--==============================================================--

local function FastInteract(prompt)

    if not prompt
        or not prompt:IsA("ProximityPrompt") then
        return
    end

    if not prompt.Enabled then
        return
    end

    pcall(function()

        fireproximityprompt(
            prompt,
            1,
            true
        )

    end)
end

