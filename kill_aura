--==============================================================
-- MAP TELEPORT
--==============================================================

local function TeleportToGuard(Data, Button, StatusLabel)

	if Closed then
		return
	end

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0
		or not Root
		or not Root.Parent then

		if StatusLabel then
			StatusLabel.Text = "CHARACTER NOT READY"
		end

		return
	end

	local Guard =
		FindGuard(Data.Path)

	if not Guard then

		if StatusLabel then
			StatusLabel.Text =
				"GUARD NOT FOUND"
		end

		if Button then
			TweenService:Create(
				Button,
				TweenInfo.new(0.12),
				{
					BackgroundColor3 =
						Color3.fromRGB(80,25,35)
				}
			):Play()

			task.delay(0.3,function()

				if Button and Button.Parent then

					TweenService:Create(
						Button,
						TweenInfo.new(0.15),
						{
							BackgroundColor3 =
								Color3.fromRGB(13,22,36)
						}
					):Play()

				end

			end)
		end

		return
	end

	-- STOP ANTI EGG WALK
	AntiEggToken += 1
	AntiEggWalking = false

	if AntiEggWalkConnection then
		AntiEggWalkConnection:Disconnect()
		AntiEggWalkConnection = nil
	end

	-- TELEPORT
	local Success =
		pcall(function()

			Root.CFrame =
				Guard.CFrame
				+ Vector3.new(0,3,0)

		end)

	if Success then

		pcall(function()

			MapTeleportSound:Stop()
			MapTeleportSound.TimePosition = 0
			MapTeleportSound:Play()

		end)

		if StatusLabel then
			StatusLabel.Text = "TELEPORTED"
		end

		TweenService:Create(
			Button,
			TweenInfo.new(0.08),
			{
				BackgroundColor3 =
					Color3.fromRGB(20,55,75)
			}
		):Play()

		task.delay(0.12,function()

			if Button and Button.Parent then

				TweenService:Create(
					Button,
					TweenInfo.new(0.15),
					{
						BackgroundColor3 =
							Color3.fromRGB(13,22,36)
					}
				):Play()

			end

		end)

	else

		if StatusLabel then
			StatusLabel.Text =
				"TELEPORT ERROR"
		end

	end
end

