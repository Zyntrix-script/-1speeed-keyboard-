local function GetLinkTool(tool)
	if not tool then return nil end
	local tc = tool:FindFirstChildWhichIsA("TouchInterest", true)
	if tc then return tc.Parent end
	local hd = tool:FindFirstChild("Handle")
	if hd and hd:IsA("BasePart") then return hd end
	return tool:FindFirstChildWhichIsA("BasePart", true)
end

-- =============================================================================
-- LOGIC TỐI ƯU CHỐNG NÓNG MÁY / KHÔNG LAG
-- =============================================================================
RunService.Stepped:Connect(function()
	local currentTime = tick()
	
	-- Giới hạn tần suất xử lý logic farm để giảm tải CPU
	if currentTime - LastTick >= ScanInterval then
		LastTick = currentTime
		
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		
		if hrp then
			-- 1. Nhặt Kim Cương gộp (Diamond + DiamondDrop)
			if _G.AutoDiamondAllEnabled then
				for _, obj in pairs(workspace:GetDescendants()) do
					if (obj.Name == "Diamond" or obj.Name == "DiamondDrop") and obj:IsA("BasePart") then
						pcall(function()
							firetouchinterest(hrp, obj, 0)
							firetouchinterest(hrp, obj, 1)
						end)
					end
				end
			end
			
			-- 2. Kill Player (Khoảng cách 100)
			if _G.AutoAuraEnabled then
				local tool = char and char:FindFirstChildWhichIsA("Tool")
				local toolPart = GetLinkTool(tool)
				
				if toolPart then
					local targetFound = false
					for _, obj in ipairs(workspace:GetChildren()) do
						if obj:IsA("Model") and obj ~= char then
							local isPlayer = Players:GetPlayerFromCharacter(obj)
							if isPlayer then
								local tHum = obj:FindFirstChildWhichIsA("Humanoid")
								local tRoot = obj:FindFirstChild("HumanoidRootPart")
								if tHum and tHum.Health > 0 and tRoot then
									if (hrp.Position - tRoot.Position).Magnitude <= AuraDistance then
										targetFound = true
										pcall(function()
											firetouchinterest(toolPart, tRoot, 1)
											firetouchinterest(toolPart, tRoot, 0)
										end)
									end
								end
							end
						end
					end
					if targetFound and tool:IsDescendantOf(workspace) then
						task.spawn(function() pcall(function() tool:Activate() end) end)
					end
				end
			end
		end
	end
	
	-- 3. ESP Kim Cương mượt mà độc lập (Cập nhật riêng cho line trực quan)
	if _G.EspDiamondEnabled then
		local currentDiamonds = {}
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		
		for _, obj in pairs(workspace:GetDescendants()) do
			if (obj.Name == "Diamond" or obj.Name == "DiamondDrop") and obj:IsA("BasePart") then
				currentDiamonds[obj] = true
				
				if not ActiveEsps[obj] then
					local line = Drawing.new("Line")
					line.Visible = false
					line.Color = Color3.fromRGB(0, 212, 255)
					line.Thickness = 1.5
					
					local text = Drawing.new("Text")
					text.Visible = false
					text.Center = true
					text.Outline = true
					text.Color = Color3.fromRGB(255, 255, 255)
					text.Size = 13
					
					ActiveEsps[obj] = {Line = line, Text = text}
				end
				
				local espData = ActiveEsps[obj]
				local vector, onScreen = Camera:WorldToViewportPoint(obj.Position)
				
				if onScreen and hrp then
					local dist = math.floor((hrp.Position - obj.Position).Magnitude)
					
					espData.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					espData.Line.To = Vector2.new(vector.X, vector.Y)
					espData.Line.Visible = true
					
					espData.Text.Text = string.format("[%s] [%dm]", obj.Name, dist)
					espData.Text.Position = Vector2.new(vector.X, vector.Y - 20)
					espData.Text.Visible = true
				else
					espData.Line.Visible = false
					espData.Text.Visible = false
				end
			end
		end
		
		-- Dọn dẹp rác ESP khi kim cương biến mất
		for obj, espData in pairs(ActiveEsps) do
			if not currentDiamonds[obj] or not obj:IsDescendantOf(workspace) then
				if espData.Line then espData.Line:Remove() end
				if espData.Text then espData.Text:Remove() end
				ActiveEsps[obj] = nil
			end
		end
	else
		-- Ẩn hoặc hủy dọn dẹp nếu tắt ESP
		for _, espData in pairs(ActiveEsps) do
			if espData.Line then espData.Line.Visible = false end
			if espData.Text then espData.Text.Visible = false end
		end
	end
end)

