--==============================================================
-- GET COORDINATES
--==============================================================

local function GetButtonCoordinates()

    local output = {}

    table.insert(
        output,
        "-- MOBILE CONTROL SUITE V6"
    )

    table.insert(
        output,
        "-- TOTAL: 37 BUTTONS"
    )

    table.insert(
        output,
        ""
    )

    for _, key in ipairs(
        OrderedKeys
    ) do

        local button =
            allButtons[key]

        if button
            and
            button.Parent then

            local pos =
                button.Position

            local size =
                button.Size

            table.insert(

                output,

                string.format(

                    '%s = {\n' ..
                    '    XScale = %.4f,\n' ..
                    '    XOffset = %d,\n' ..
                    '    YScale = %.4f,\n' ..
                    '    YOffset = %d,\n' ..
                    '    Width = %d,\n' ..
                    '    Height = %d\n' ..
                    '},',

                    key,

                    pos.X.Scale,
                    pos.X.Offset,

                    pos.Y.Scale,
                    pos.Y.Offset,

                    size.X.Offset,
                    size.Y.Offset

                )

            )

        end

    end

    return table.concat(
        output,
        "\n"
    )

end

--==============================================================
-- CLIPBOARD
--==============================================================

local function CopyClipboard(text)

    if setclipboard then

        local success =
            pcall(
                function()

                    setclipboard(
                        text
                    )

                end
            )

        if success then
            return true
        end

    end

    if toclipboard then

        local success =
            pcall(
                function()

                    toclipboard(
                        text
                    )

                end
            )

        if success then
            return true
        end

    end

    return false

end

