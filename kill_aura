    Humanoid.Died:Connect(function()

        if Destroyed then
            return
        end

        StopWalking()

        if WalkButton
        and WalkButton.Parent then

            WalkButton.Text =
                "🚶 WALK"

            WalkStroke.Color =
                CYAN
        end

        if Status
        and Status.Parent then

            Status.Text =
                "● RESPAWN..."

            Status.TextColor3 =
                RED
        end
    end)
end

