--========================================================--
-- HELPERS
--========================================================--

local function New(className, parent, props)

    local obj =
        Instance.new(className)

    for property, value in pairs(props or {}) do

        pcall(function()
            obj[property] = value
        end)

    end

    obj.Parent = parent

    return obj

end


local function Corner(parent, radius)

    return New("UICorner", parent, {
        CornerRadius =
            UDim.new(0,radius or 10)
    })

end


local function Stroke(
    parent,
    color,
    transparency,
    thickness
)

    return New("UIStroke", parent, {

        Color =
            color or BORDER,

        Transparency =
            transparency or 0,

        Thickness =
            thickness or 1

    })

end


local function Gradient(
    parent,
    colors,
    rotation
)

    local gradient =
        New("UIGradient", parent, {
            Rotation = rotation or 0
        })

    local points = {}

    for i,color in ipairs(colors) do

        table.insert(
            points,
            ColorSequenceKeypoint.new(
                (i-1) /
                math.max(#colors-1,1),
                color
            )
        )

    end

    gradient.Color =
        ColorSequence.new(points)

    return gradient

end


local function Tween(
    object,
    time,
    properties,
    style,
    direction
)

    local info =
        TweenInfo.new(
            time,
            style or Enum.EasingStyle.Quad,
            direction or Enum.EasingDirection.Out
        )

    local tween =
        TweenService:Create(
            object,
            info,
            properties
        )

    tween:Play()

    return tween

end


