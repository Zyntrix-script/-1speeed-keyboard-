-- DEATH
--==============================================================

local function BindDeath()

	if DeathConnection then

		DeathConnection:Disconnect()
		DeathConnection = nil

	end

	if not Humanoid then
		return
	end

	DeathConnection =
		Humanoid.Died:Connect(function()

			IsDead = true

			AntiEggToken += 1

			StopAntiEggWalk()

			pcall(function()

				MapTeleportSound:Stop()
				AntiEggSound:Stop()

			end)

			EggStatus.Text =
				"DEAD • RESPAWN"

			EggStatus.TextColor3 =
				Color3.fromRGB(255,120,120)

			EggToggle.Text =
				"ANTI EGG • RESPAWN"

		end)

end

