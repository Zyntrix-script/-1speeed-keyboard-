--==============================================================
-- CONTINUOUS TEXT SHINE
--==============================================================

local function ContinuousShine(TextObject, BaseColor, ShineColor, Speed)

	local Gradient = Instance.new("UIGradient")
	Gradient.Parent = TextObject

	Gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, BaseColor),
		ColorSequenceKeypoint.new(0.40, BaseColor),
		ColorSequenceKeypoint.new(0.47, ShineColor),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255,255,255)),
		ColorSequenceKeypoint.new(0.53, ShineColor),
		ColorSequenceKeypoint.new(0.60, BaseColor),
		ColorSequenceKeypoint.new(1, BaseColor)
	})

	Gradient.Offset = Vector2.new(-1, 0)

	task.spawn(function()

		while TextObject.Parent do

			Gradient.Offset = Vector2.new(-1, 0)

			local Tween = TweenService:Create(
				Gradient,
				TweenInfo.new(
					Speed or 1.5,
					Enum.EasingStyle.Linear
				),
				{
					Offset = Vector2.new(1, 0)
				}
			)

			Tween:Play()
			Tween.Completed:Wait()

		end

	end)

	return Gradient
end

