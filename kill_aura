local function FastInteract(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return
    end

    if not prompt.Enabled then
        return
    end

    -- Chỉ kích hoạt khi người chơi tự bắt đầu tương tác
    pcall(function()
        fireproximityprompt(prompt, 1, true)
    end)
end

