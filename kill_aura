--==============================================================
-- SEND VIRTUAL KEY
--==============================================================

local function SendVirtualKey(
    key,
    state
)

    if editMode then
        return
    end

    if not controlsEnabled then
        return
    end

    local keyCode =
        KeyCodes[key]

    if not keyCode then
        return
    end

    if VirtualInputManager then

        pcall(function()

            VirtualInputManager:SendKeyEvent(
                state,
                keyCode,
                false,
                game
            )

        end)

    end

    VirtualKeyEvent:Fire(
        key,
        state
    )

end

--==============================================================
-- PRESS KEY
--==============================================================

local function PressKey(
    key,
    state
)

    if editMode then
        return
    end

    if not controlsEnabled then
        return
    end

    SendVirtualKey(
        key,
        state
    )

    --==========================================================
    -- MOVEMENT STATE
    --==========================================================

    if activeMovement[key] ~= nil then

        activeMovement[key] =
            state

    end

    --==========================================================
    -- SPACE
    --==========================================================

    if key == "SPACE"
        and state then

        local character =
            Player.Character

        local humanoid =
            character
            and
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if humanoid then
            humanoid.Jump = true
        end

    end

    --==========================================================
    -- SHIFT
    --==========================================================

    if key == "SHIFT" then

        local character =
            Player.Character

        local humanoid =
            character
            and
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if humanoid then

            if state then

                humanoid.WalkSpeed =
                    24

            else

                humanoid.WalkSpeed =
                    16

            end

        end

    end

end

--==============================================================
-- TEXT SIZE
--==============================================================

local function GetTextSize(key)

    if key == "SPACE" then
        return 11
    end

    if key == "SHIFT"
        or key == "CTRL" then

        return 9

    end

    if key == "TAB" then
        return 10
    end

    return 12

end

--==============================================================
-- SAFE POSITION
--==============================================================

local function SafePosition(
    position,
    size
)

    local viewport =
        ControlLayer.AbsoluteSize

    local screenW =
        viewport.X

    local screenH =
        viewport.Y

    local width =
        size.X.Offset

    local height =
        size.Y.Offset

    local x
    local y

    if position.X.Scale ~= 0 then

        x =
            screenW *
            position.X.Scale +
            position.X.Offset

    else

        x =
            position.X.Offset

    end

    if position.Y.Scale ~= 0 then

        y =
            screenH *
            position.Y.Scale +
            position.Y.Offset

    else

        y =
            position.Y.Offset

    end

    x =
        math.clamp(
            x,
            0,
            math.max(
                0,
                screenW - width
            )
        )

    y =
        math.clamp(
            y,
            0,
            math.max(
                0,
                screenH - height
            )
        )

    return UDim2.fromOffset(
        Snap(x),
        Snap(y)
    )

end

--==============================================================
-- CREATE KEY
--==============================================================

local function CreateKey(
    key,
    position,
    size
)

    local button =
        Instance.new("TextButton")

    button.Name =
        "Key_" .. key

    local normalSize =
        size or
        UDim2.fromOffset(
            42,
            42
        )

    button.Size =
        normalSize

    button.Position =
        SafePosition(
            position,
            normalSize
        )

    button.BackgroundColor3 =
        Color3.fromRGB(
            25,
            25,
            30
        )

    button.BackgroundTransparency =
        0.25

    button.Text =
        key

    button.TextColor3 =
        Color3.new(
            1,
            1,
            1
        )

    button.Font =
        Enum.Font.GothamBold

    button.TextSize =
        GetTextSize(key)

    button.TextScaled =
        false

    button.TextWrapped =
        false

    button.AutoButtonColor =
        false

    button.Active =
        true

    button.Selectable =
        false

    button.ZIndex =
        2

    button.Parent =
        ControlLayer

    --==========================================================
    -- CORNER
    --==========================================================

    local corner =
        Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(
            key == "SPACE"
                and 0.25
                or 0.18,
            0
        )

    corner.Parent =
        button

    --==========================================================
    -- STROKE
    --==========================================================

    local stroke =
        Instance.new("UIStroke")

    stroke.Color =
        Color3.new(
            1,
            1,
            1
        )

    stroke.Transparency =
        0.72

    stroke.Thickness =
        1

    stroke.Parent =
        button

    allButtons[key] =
        button

    SaveDefault(button)

    --==========================================================
    -- TOUCH BEGIN
    --==========================================================

    button.InputBegan:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.Touch then

                return

            end

            --==================================================
            -- EDIT MODE
            --==================================================

            if editMode then

                if not layoutLocked then

                    draggingButton =
                        button

                    dragStart =
                        input.Position

                    startPosition =
                        button.Position

                    button.ZIndex =
                        100

                    button.BackgroundTransparency =
                        0.05

                end

                return

            end

            --==================================================
            -- NORMAL MODE
            --==================================================

            if not controlsEnabled then
                return
            end

            PressKey(
                key,
                true
            )

            button.BackgroundTransparency =
                0.05

        end
    )

    --==========================================================
    -- TOUCH END
    --==========================================================

    button.InputEnded:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.Touch then

                return

            end

            if draggingButton == button then

                -- Don't release key in edit mode
                EndDrag()

                return

            end

            if editMode then
                return
            end

            if not controlsEnabled then
                return
            end

            PressKey(
                key,
                false
            )

            button.BackgroundTransparency =
                0.25

        end
    )

    return button

end

