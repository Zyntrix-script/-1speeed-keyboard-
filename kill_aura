--========================================================
-- CHARACTER
--========================================================

local function GetParts()
    local char = LP.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if hum and root and hum.Health > 0 then
        return char, hum, root
    end
end

local function TeleportTo(position)
    local char = GetParts()
    if not char then return false end

    char:PivotTo(CFrame.new(position))
    return true
end

--========================================================
-- FIND TRACKSTART
--========================================================

local function FindTrackStart()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if closed then return end

        if obj.Name == "TrackStart" then
            if obj:IsA("BasePart") then
                return obj
            elseif obj:IsA("Model") then
                local part = obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)

                if part then
                    return part
                end
            end
        end
    end
end

--========================================================
-- SMOOTH TELEPORT
--========================================================

local function SmoothTeleport(target)
    if busy then return false end
    busy = true

    local char, hum, root = GetParts()
    if not char then
        busy = false
        return false
    end

    local start = root.Position
    local rotation = root.CFrame.Rotation

    for i = 1, STEPS do
        if closed or not char.Parent
            or not root.Parent or hum.Health <= 0 then
            busy = false
            return false
        end

        local a = i / STEPS
        local eased = a * a * (3 - 2 * a)
        local pos = start:Lerp(target, eased)

        char:PivotTo(CFrame.new(pos) * rotation)
        RunService.Heartbeat:Wait()
    end

    busy = false
    return true
end

