--==============================================================--
-- DEATH
--==============================================================--

local function BindDeath()

    if DeathConnection then

        DeathConnection:Disconnect()
        DeathConnection = nil

    end

    if not Humanoid then
        return
    end

    DeathConnection =
        Humanoid.Died:Connect(
            function()

                IsDead = true

                TeleWalkToken += 1

                StopWalking()

                if TeleSound then

                    pcall(function()
                        TeleSound:Stop()
                    end)

                end

                SetDead()

            end
        )
end

--==============================================================--
-- INITIAL CHARACTER
--==============================================================--

local InitialCharacter =
    Player.Character

if InitialCharacter then

    if SetupCharacter(
        InitialCharacter
    ) then

        BindDeath()

    else

        Status.Text =
            "CHARACTER ERROR"

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                120,
                120
            )
    end

else

    local NewCharacter =
        Player.CharacterAdded:Wait()

    if SetupCharacter(
        NewCharacter
    ) then

        BindDeath()

    end
end

--==============================================================--
-- RESPAWN
--==============================================================--

CharacterConnection =
    Player.CharacterAdded:Connect(
        function(NewCharacter)

            if Closed then
                return
            end

            TeleWalkToken += 1

            StopWalking()

            IsDead = true

            if TeleSound then

                pcall(function()
                    TeleSound:Stop()
                end)

            end

            SetDead()

            if DeathConnection then

                DeathConnection:Disconnect()
                DeathConnection = nil

            end

            task.wait(0.25)

            if Closed then
                return
            end

            local Success =
                SetupCharacter(
                    NewCharacter
                )

            if not Success then

                Status.Text =
                    "CHARACTER ERROR"

                Status.TextColor3 =
                    Color3.fromRGB(
                        255,
                        120,
                        120
                    )

                return
            end

            IsDead = false

            BindDeath()
            SetReady()

        end
    )

--==============================================================--
-- MOBILE DRAG
--==============================================================--

local Dragging = false
local DragStart
local StartPosition
local DragInput

DragBar.InputBegan:Connect(
    function(Input)

        if Closed then
            return
        end

        if Input.UserInputType
            == Enum.UserInputType.MouseButton1
            or Input.UserInputType
            == Enum.UserInputType.Touch then

            Dragging = true
            DragStart = Input.Position
            StartPosition = Main.Position

            if Input.UserInputType
                == Enum.UserInputType.Touch then

                DragInput = Input

            else

                DragInput = nil

            end
        end
    end
)

DragBar.InputChanged:Connect(
    function(Input)

        if Input.UserInputType
            == Enum.UserInputType.MouseMovement
            or Input.UserInputType
            == Enum.UserInputType.Touch then

            DragInput = Input

        end
    end
)

UserInputService.InputChanged:Connect(
    function(Input)

        if not Dragging then
            return
        end

        if not DragStart
            or not StartPosition then
            return
        end

        if DragInput then

            if Input ~= DragInput then
                return
            end

        elseif Input.UserInputType
            ~= Enum.UserInputType.MouseMovement then

            return
        end

        local Delta =
            Input.Position
            - DragStart

        if Delta.Magnitude
            < DRAG_THRESHOLD then
            return
        end

        Main.Position =
            UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset
                    + Delta.X,

                StartPosition.Y.Scale,
                StartPosition.Y.Offset
                    + Delta.Y
            )
    end
)

UserInputService.InputEnded:Connect(
    function(Input)

        if Input.UserInputType
            == Enum.UserInputType.MouseButton1
            or Input.UserInputType
            == Enum.UserInputType.Touch then

            Dragging = false
            DragInput = nil
            DragStart = nil
            StartPosition = nil

        end
    end
)

