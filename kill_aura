--==============================================================
-- FIND GUARD
--==============================================================

local function FindGuard(PathParts)

	local Current = Workspace

	for _, Name in ipairs(PathParts) do

		if not Current then
			return nil
		end

		Current = Current:FindFirstChild(Name)

	end

	if not Current then
		return nil
	end

	if Current:IsA("BasePart") then
		return Current
	end

	if Current:IsA("Attachment")
		and Current.Parent
		and Current.Parent:IsA("BasePart") then

		return Current.Parent
	end

	if Current:IsA("Model") then

		if Current.PrimaryPart then
			return Current.PrimaryPart
		end

		local Part =
			Current:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

		if Part then
			return Part
		end
	end

	return nil
end

