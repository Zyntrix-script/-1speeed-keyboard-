-- =============================================================================
-- LOGIC ĐIỀU KHIỂN CLONE SPEED 100
-- =============================================================================
local isControllingClone = false
local controllableClone = nil

local function teleportRealToClone()
	if isControllingClone and controllableClone and controllableClone:FindFirstChild("HumanoidRootPart") then
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = controllableClone.HumanoidRootPart.CFrame
		end
	end
end

local function toggleDesync()
	isControllingClone = not isControllingClone
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	
	if not char or not hrp or not hum then return end
	
	if isControllingClone then
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(15, 40, 32)
		ToggleBtn.Text = "CLONE DI CHUYỂN: ON"
		ToggleStroke.Color = Color3.fromRGB(0, 255, 136)
		ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 136)
		
		for _, v in pairs(char:GetDescendants()) do
			if v:IsA("BasePart") then v.Transparency = 0.6 end
		end
		hrp.Anchored = true
		
		char.Archivable = true
		controllableClone = char:Clone()
		controllableClone.Name = "Controllable_Clone"
		
		local hl = Instance.new("Highlight", controllableClone)
		hl.FillColor = Color3.fromRGB(0, 255, 255)
		hl.OutlineColor = Color3.fromRGB(0, 255, 255)
		hl.FillTransparency = 0.8
		
		for _, v in pairs(controllableClone:GetDescendants()) do
			if v:IsA("BasePart") then v.CanCollide = true v.Anchored = false end
			if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
		end
		
		controllableClone.Parent = Workspace
		controllableClone:SetPrimaryPartCFrame(hrp.CFrame)
		
		local cloneHum = controllableClone:FindFirstChild("Humanoid")
		if cloneHum then cloneHum.WalkSpeed = 100 end
		
		Camera.CameraSubject = cloneHum
		
		task.spawn(function()
			while isControllingClone and controllableClone and controllableClone:FindFirstChild("Humanoid") do
				controllableClone.Humanoid:Move(hum.MoveDirection, false)
				if hum.Jump then controllableClone.Humanoid.Jump = true end
				task.wait()
			end
		end)
	else
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 25)
		ToggleBtn.Text = "CLONE DI CHUYỂN: OFF"
		ToggleStroke.Color = Color3.fromRGB(255, 46, 99)
		ToggleBtn.TextColor3 = Color3.fromRGB(255, 46, 99)
		
		hrp.Anchored = false
		if controllableClone and controllableClone:FindFirstChild("HumanoidRootPart") then
			hrp.CFrame = controllableClone.HumanoidRootPart.CFrame
		end
		
		if hum then Camera.CameraSubject = hum end
		for _, v in pairs(char:GetDescendants()) do
			if v:IsA("BasePart") then v.Transparency = 0 end
		end
		
		if controllableClone then 
			controllableClone:Destroy() 
			controllableClone = nil 
		end
	end
end

ToggleBtn.MouseButton1Click:Connect(toggleDesync)
TeleBtn.MouseButton1Click:Connect(teleportRealToClone)

-- =============================================================================
-- LOGIC DỪNG THỜI GIAN TẤT CẢ NGƯỜI CHƠI KHÁC (TIME STOP - FIX 2026)
-- =============================================================================
TimeStopBtn.MouseButton1Click:Connect(function()
	_G.TimeStopEnabled = not _G.TimeStopEnabled
	
	if _G.TimeStopEnabled then
		TimeStopBtn.BackgroundColor3 = Color3.fromRGB(15, 40, 32)
		TimeStopBtn.Text = "DỪNG THỜI GIAN NGƯỜI CHƠI: ON"
		TimeStopStroke.Color = Color3.fromRGB(0, 255, 136)
		TimeStopBtn.TextColor3 = Color3.fromRGB(0, 255, 136)
	else
		TimeStopBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 25)
		TimeStopBtn.Text = "DỪNG THỜI GIAN NGƯỜI CHƠI: OFF"
		TimeStopStroke.Color = Color3.fromRGB(255, 46, 99)
		TimeStopBtn.TextColor3 = Color3.fromRGB(255, 46, 99)
		
		-- Khôi phục trạng thái cho các bộ phận khi tắt Time Stop
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if hrp then
					hrp.Anchored = false
				end
				if hum then
					hum.PlatformStand = false
				end
			end
		end
	end
end)

-- Vòng lặp liên tục đóng băng mọi người chơi khác (Sửa lỗi cú pháp & tương thích phiên bản mới)
RunService.Stepped:Connect(function()
	if _G.TimeStopEnabled then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local char = player.Character
				local hrp = char:FindFirstChild("HumanoidRootPart")
				local hum = char:FindFirstChildOfClass("Humanoid")
				
				if hrp then
					hrp.Anchored = true
					pcall(function()
						hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end)
				end
				if hum then
					hum.PlatformStand = true
				end
			end
		end
	end
end)

